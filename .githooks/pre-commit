#!/bin/sh
# Hook wrapper: invokes pre-commit framework's pre-commit stage.
# Configured via .pre-commit-config.yaml at the repo root. Tracked in
# version control; activated for this clone via:
#   git config core.hooksPath .githooks
# (run tools/setup-repo.sh once per clone).
#
# Not to be confused with hooks/pre-commit, which is unrelated Dart-tooling
# library source (the pre-existing `hooks/install.sh` flow that copies to
# .git/hooks/) — this wrapper lives in .githooks/ and is wired in via
# core.hooksPath instead.
HERE="$(cd "$(dirname "$0")" && pwd)"
# git invokes hooks from the worktree root, but `cd` here defends
# against manual invocation from a subdirectory so the relative
# --config path always resolves.
cd "$(git rev-parse --show-toplevel)"
exec pre-commit hook-impl \
  --config=.pre-commit-config.yaml \
  --hook-type=pre-commit \
  --hook-dir "$HERE" \
  -- "$@"
